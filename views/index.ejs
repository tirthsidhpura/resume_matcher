<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Analyzer Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 24px;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    .container-custom {
      max-width: 1700px;
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    h1 {
      margin: 0;
      font-size: 30px;
    }

    .meta {
      color: #6b7280;
      font-size: 15px;
    }

    .meta-box {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 14px;
      color: #374151;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }

    .filter-bar .form-control,
    .filter-bar .form-select {
      min-width: 180px;
    }

    .table-wrapper {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      overflow: auto;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1700px;
    }

    th, td {
      padding: 14px 12px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid #e5e7eb;
      font-size: 14px;
    }

    th {
      background: #f9fafb;
      color: #374151;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 2;
    }

    tr:hover td {
      background: #fcfcfd;
    }

    .source-badge {
      display: inline-block;
      background: #eef2ff;
      color: #3730a3;
      font-size: 12px;
      font-weight: bold;
      padding: 6px 10px;
      border-radius: 999px;
      text-transform: capitalize;
    }

    .status-badge {
      display: inline-block;
      font-size: 12px;
      font-weight: bold;
      padding: 6px 10px;
      border-radius: 999px;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .status-pending {
      background: #fff7ed;
      color: #c2410c;
    }

    .status-processing {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .status-completed {
      background: #ecfdf5;
      color: #047857;
    }

    .status-failed {
      background: #fef2f2;
      color: #b91c1c;
    }

    .job-title {
      font-size: 16px;
      font-weight: 700;
      line-height: 1.4;
      min-width: 220px;
    }

    .muted {
      color: #6b7280;
      font-size: 13px;
    }

    .url-box,
    .analysis-box,
    .error-box {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 10px;
      line-height: 1.5;
    }

    .url-box,
    .analysis-box,
    .error-box {
      max-height: 180px;
      overflow: auto;
      min-width: 220px;
    }

    .error-box {
      background: #fef2f2;
      color: #991b1b;
      border-color: #fecaca;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .desc-preview {
      max-width: 320px;
      line-height: 1.5;
      color: #111827;
      white-space: normal;
      word-break: break-word;
    }

    .action-group {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }

    .copy-btn {
      border: none;
      background: #111827;
      color: white;
      padding: 7px 11px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: bold;
    }

    .copy-btn:hover {
      opacity: 0.9;
    }

    .copy-btn.copied {
      background: #047857;
    }

    .score {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 6px;
    }

    .recommendation {
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .good {
      color: #047857;
    }

    .bad {
      color: #b91c1c;
    }

    .chip-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .chip {
      display: inline-block;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 12px;
      color: #374151;
    }

    .list {
      margin: 6px 0 0;
      padding-left: 18px;
    }

    .list li {
      margin-bottom: 5px;
      line-height: 1.5;
    }

    .empty {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      padding: 24px;
      color: #6b7280;
    }

    .modal-description {
      white-space: pre-wrap;
      line-height: 1.7;
      font-size: 15px;
      color: #111827;
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 14px;
      max-height: 430px;
      overflow: auto;
    }

    .modal-meta {
      font-size: 14px;
      color: #4b5563;
      margin-top: 4px;
    }

    .modal-section-title {
      font-size: 13px;
      font-weight: 700;
      color: #374151;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .open-link {
      word-break: break-all;
    }

    .hidden-row {
      display: none !important;
    }

    .modal-toggle-group .btn.active-view {
      background: #111827;
      color: #fff;
      border-color: #111827;
    }

    .prompt-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    @media (max-width: 768px) {
      body {
        padding: 14px;
      }

      h1 {
        font-size: 24px;
      }

      .filter-bar .form-control,
      .filter-bar .form-select {
        min-width: 100%;
      }
    }

        .app-status-not_applied {
      background: #f3f4f6;
      color: #374151;
    }

    .app-status-applied {
      background: #ecfdf5;
      color: #047857;
    }

    .app-status-rejected {
      background: #fef2f2;
      color: #b91c1c;
    }

    .status-action-btn {
      border: none;
      padding: 6px 10px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 12px;
      font-weight: bold;
    }

    .status-action-btn.not-applied-btn {
      background: #e5e7eb;
      color: #111827;
    }

    .status-action-btn.applied-btn {
      background: #dcfce7;
      color: #166534;
    }

    .status-action-btn.rejected-btn {
      background: #fee2e2;
      color: #991b1b;
    }

    .status-action-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
  <div class="container-custom">
    <div class="topbar">
      <div>
        <h1>Job Analyzer Dashboard</h1>
        <p class="muted mb-2">
          <% if (selectedDate) { %>
            Jobs saved on <strong><%= new Date(selectedDate + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></strong> (UTC)
          <% } else { %>
            No saved jobs yet
          <% } %>
        </p>
        <div class="d-flex flex-wrap gap-2 mt-2">
          <div class="meta-box">
            Total Jobs: <strong id="totalJobsCount"><%= jobs?.length || 0 %></strong>
          </div>
          <div class="meta-box">
            Visible Jobs: <strong id="visibleJobsCount"><%= jobs?.length || 0 %></strong>
          </div>
        </div>
      </div>
      <div>
        <form action="/" method="get" class="d-flex align-items-end flex-wrap gap-2 mb-2">
          <div>
            <label for="jobDate" class="form-label mb-1">Saved Date</label>
            <input id="jobDate" name="date" type="date" class="form-control form-control-sm" value="<%= selectedDate %>" required>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Submit</button>
          <a class="btn btn-outline-secondary btn-sm" href="/">Latest Date</a>
        </form>
        <a class="btn btn-outline-dark btn-sm" href="/api/jobs<%= selectedDate ? '?date=' + selectedDate : '' %>" target="_blank">Open API JSON</a>
      </div>
    </div>

    <% 
      const uniqueSources = [...new Set((jobs || []).map(j => (j.source || "").trim()).filter(Boolean))];
    %>

    <div class="filter-bar">
      <select id="statusFilter" class="form-select form-select-sm">
        <option value="">All Status</option>
        <option value="completed" selected>Completed</option>
        <option value="processing">Processing</option>
        <option value="pending">Pending</option>
        <option value="failed">Failed</option>
      </select>

      <select id="sourceFilter" class="form-select form-select-sm">
        <option value="">All Sources</option>
        <% uniqueSources.forEach(src => { %>
          <option value="<%= src.toLowerCase() %>"><%= src %></option>
        <% }) %>
      </select>

      <input
        type="number"
        id="scoreFilter"
        class="form-control form-control-sm"
        placeholder="Min Match %"
        value="7"
        min="0"
        max="100"
      />

      <input
        type="text"
        id="searchFilter"
        class="form-control form-control-sm"
        placeholder="Search title..."
      />

            <select id="applicationStatusFilter" class="form-select form-select-sm">
        <option value="">All Application Status</option>
        <option value="not_applied" selected>Not Applied</option>
        <option value="applied">Applied</option>
        <option value="rejected">Rejected</option>
      </select>

      <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
        Clear Filters
      </button>
    </div>

    <div id="noMatchingJobsMessage" class="empty" style="display:none; margin-bottom: 18px;">
      No jobs match the selected filters.
    </div>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="empty">
        <%= selectedDate ? 'No jobs found for this date.' : 'No jobs found in database.' %>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>MongoDB ID</th>
              <th>Source</th>
              <th>Company Name</th>
              <th>Status</th>
              <th>Application Status</th>
              <th>Title</th>
              <th>Location</th>
              <th>Captured At</th>
              <th>Saved At</th>
              <th>Job URL</th>
              <th>Description</th>
              <th>Analysis</th>
              <th>Error</th>
            </tr>
          </thead>
          <tbody id="jobsTableBody">
            <% jobs.forEach((job, index) => { 
              const score = job.analysis?.match_score ?? 0;
              const shortDescription = job.description
                ? (job.description.length > 50
                    ? job.description.substring(0, 50) + "..."
                    : job.description)
                : "N/A";

              const shortUrl = job.url
                ? (job.url.length > 30
                    ? job.url.substring(0, 30) + "..."
                    : job.url)
                : "N/A";
            %>
                          <tr
                data-id="<%= job._id %>"
                data-mainID="<%= job._id %>"
                data-status="<%= (job.analysisStatus || 'pending').toLowerCase() %>"
                data-application-status="<%= (job.applicationStatus || 'not_applied').toLowerCase() %>"
                data-source="<%= (job.source || '').toLowerCase() %>"
                data-score="<%= score %>"
                data-title="<%= (job.title || '').toLowerCase() %>"
              >
                <td><strong><%= index + 1 %></strong></td>

                <td>
                  <div class="d-flex align-items-center gap-2 text-nowrap">
                    <code><%= job._id %></code>
                    <button
                      type="button"
                      class="copy-btn"
                      data-mongodb-id="<%= job._id %>"
                      title="Copy MongoDB ID"
                      aria-label="Copy MongoDB ID"
                      onclick="copyPlainText(this.dataset.mongodbId, this)"
                    >&#10697;</button>
                  </div>
                </td>

                <td>
                  <span class="source-badge"><%= job.source || "Unknown Source" %></span>
                </td>

                <td>
                  <span class="source-badge"><%= job.analysis?.company_name || "Unknown Company" %></span>
                </td>

                <td>
                  <span class="status-badge status-<%= job.analysisStatus || 'pending' %>">
                    <%= job.analysisStatus || "pending" %>
                  </span>
                  <div class="action-group">
                    <button type="button" class="btn btn-sm btn-outline-primary restart-analysis-btn"
                      data-job-id="<%= job._id %>"
                      >
                      &#8635; Restart Analysis
                    </button>
                  </div>
                </td>

                                <td>
                  <span class="status-badge app-status-badge app-status-<%= job.applicationStatus || 'not_applied' %>">
                    <%= (job.applicationStatus || 'not_applied').replace('_', ' ') %>
                  </span>

                  <div class="action-group">
                    <button
                      type="button"
                      class="status-action-btn not-applied-btn application-status-btn"
                      data-job-id="<%= job._id %>"
                      data-status="not_applied"
                    >
                      Not Applied
                    </button>

                    <button
                      type="button"
                      class="status-action-btn applied-btn application-status-btn"
                      data-job-id="<%= job._id %>"
                      data-status="applied"
                    >
                      Applied
                    </button>

                    <button
                      type="button"
                      class="status-action-btn rejected-btn application-status-btn"
                      data-job-id="<%= job._id %>"
                      data-status="rejected"
                    >
                      Rejected
                    </button>
                  </div>
                </td>

                <td>
                  <div class="job-title"><%= job.title || "Untitled Job" %></div>
                </td>

                <td><%= job.location || "N/A" %></td>

                <td class="muted">
                  <%= job.capturedAt ? new Date(job.capturedAt).toLocaleString() : "N/A" %>
                </td>

                <td class="muted">
                  <%= job.createdAt ? new Date(job.createdAt).toLocaleString() : "N/A" %>
                </td>

                <td>
                  <% if (job.url) { %>
                    <div id="url-<%= index %>" class="url-box"><%= shortUrl %></div>
                    <div class="action-group">
                      <a
                        class="btn btn-sm btn-outline-primary"
                        href="<%= job.url %>"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Open
                      </a>
                      <button
                        class="copy-btn"
                        type="button"
                        onclick="copyPlainText('<%- JSON.stringify(job.url || '').slice(1, -1) %>', this, 'Copy URL')"
                      >
                        Copy URL
                      </button>
                    </div>
                  <% } else { %>
                    <span class="muted">N/A</span>
                  <% } %>
                </td>

                <td>
                  <div class="desc-preview"><%= shortDescription %></div>

                  <div class="action-group">
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-dark"
                      data-bs-toggle="modal"
                      data-bs-target="#jobModal"
                      data-mainID="<%= job._id || 'Untitled Job' %>"
                      data-title="<%= job.title || 'Untitled Job' %>"
                      data-company_name="<%= job.analysis?.company_name || 'Untitled Job Name' %>"
                      data-source="<%= job.source || 'Unknown Source' %>"
                      data-status="<%= job.analysisStatus || 'pending' %>"
                      data-location="<%= job.location || 'N/A' %>"
                      data-capturedat="<%= job.capturedAt ? new Date(job.capturedAt).toLocaleString() : 'N/A' %>"
                      data-createdat="<%= job.createdAt ? new Date(job.createdAt).toLocaleString() : 'N/A' %>"
                      data-url="<%= job.url || '' %>"
                      data-description="<%= job.description || 'N/A' %>"
                      data-summary="<%= job.analysis?.summary || 'No summary available' %>"
                      data-missingkeywords='<%- JSON.stringify(job.analysis?.missing_keywords || []) %>'
                      data-strongmatches='<%- JSON.stringify(job.analysis?.strong_matches || []) %>'
                    >
                      Expand
                    </button>
                  </div>
                </td>

                <td>
                  <% if (job.analysisStatus === "completed") { %>
                    <div class="analysis-box">
                      <div class="score"><%= job.analysis?.match_score ?? "N/A" %>%</div>

                      <div class="recommendation <%= job.analysis?.recommendation === 'GOOD TO APPLY' ? 'good' : 'bad' %>">
                        <%= job.analysis?.recommendation || "N/A" %>
                      </div>

                      <div><strong>Summary:</strong> <%= job.analysis?.summary || "N/A" %></div>

                      <div style="margin-top: 10px;"><strong>Resume Keywords:</strong></div>
                      <div class="chip-wrap">
                        <% if (job.analysis?.resume_keywords?.length) { %>
                          <% job.analysis.resume_keywords.forEach(keyword => { %>
                            <span class="chip"><%= keyword %></span>
                          <% }) %>
                        <% } else { %>
                          <span class="muted">No data</span>
                        <% } %>
                      </div>

                      <div style="margin-top: 10px;"><strong>Matched Keywords:</strong></div>
                      <div class="chip-wrap">
                        <% if (job.analysis?.matched_keywords?.length) { %>
                          <% job.analysis.matched_keywords.forEach(keyword => { %>
                            <span class="chip"><%= keyword %></span>
                          <% }) %>
                        <% } else { %>
                          <span class="muted">No data</span>
                        <% } %>
                      </div>

                      <div style="margin-top: 10px;"><strong>Missing Keywords:</strong></div>
                      <div class="chip-wrap">
                        <% if (job.analysis?.missing_keywords?.length) { %>
                          <% job.analysis.missing_keywords.forEach(keyword => { %>
                            <span class="chip"><%= keyword %></span>
                          <% }) %>
                        <% } else { %>
                          <span class="muted">No data</span>
                        <% } %>
                      </div>

                      <div style="margin-top: 10px;"><strong>Strong Matches:</strong></div>
                      <% if (job.analysis?.strong_matches?.length) { %>
                        <ul class="list">
                          <% job.analysis.strong_matches.forEach(point => { %>
                            <li><%= point %></li>
                          <% }) %>
                        </ul>
                      <% } else { %>
                        <div class="muted">No data</div>
                      <% } %>

                      <% if (job.analysis?.parse_error) { %>
                        <div style="margin-top: 10px;"><strong>Raw Model Response:</strong></div>
                        <div class="error-box"><%= job.analysis?.raw_response || "No raw response available" %></div>
                      <% } %>
                    </div>
                  <% } else if (["processing", "pending", "queued"].includes(job.analysisStatus)) { %>
                    <div class="analysis-box muted">Analysis is in progress...</div>
                  <% } else { %>
                    <span class="muted">N/A</span>
                  <% } %>
                </td>

                <td>
                  <% if (job.analysisStatus === "failed") { %>
                    <div class="error-box"><%= job.analysisError || "Unknown error" %></div>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="modal fade" id="jobModal" tabindex="-1" aria-labelledby="jobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title mb-1" id="jobModalLabel">Job Details</h5>
            <div class="modal-meta" id="modalJobMeta"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="row g-4">
            <div class="col-12 col-lg-5">
              <div class="modal-section-title">Job Information</div>

              <div class="mb-2"><strong>Source:</strong> <span id="modalSource"></span></div>
              <div class="mb-2"><strong>Company Name:</strong> <span id="modalCompany_name"></span></div>
              <div class="mb-2"><strong>Status:</strong> <span id="modalStatus"></span></div>
              <div class="mb-2"><strong>Location:</strong> <span id="modalLocation"></span></div>
              <div class="mb-2"><strong>Captured At:</strong> <span id="modalCapturedAt"></span></div>
              <div class="mb-2"><strong><button><a target="_blank" id="generateLink">Generate Resume </a></button></strong> <span id="modalSource"></span></div>
              <div class="mb-3"><strong>Saved At:</strong> <span id="modalCreatedAt"></span></div>

              <div class="modal-section-title">Job URL</div>
              <div id="modalUrlText" class="modal-description open-link mb-2">N/A</div>

              <div class="d-flex flex-wrap gap-2">
                <a
                  id="modalOpenUrl"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-outline-primary btn-sm"
                >
                  Open URL
                </a>

                <button
                  id="modalCopyUrlBtn"
                  type="button"
                  class="btn btn-dark btn-sm"
                >
                  Copy URL
                </button>
              </div>
            </div>

            <div class="col-12 col-lg-7">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="modal-section-title mb-0">Content</div>
                <div class="d-flex flex-wrap gap-2 modal-toggle-group">
                  <button
                    id="showDescriptionBtn"
                    type="button"
                    class="btn btn-outline-dark btn-sm active-view"
                  >
                    Description
                  </button>
                  <button
                    id="showSummaryBtn"
                    type="button"
                    class="btn btn-outline-dark btn-sm"
                  >
                    Summary
                  </button>
                  <button
                    id="modalCopyContentBtn"
                    type="button"
                    class="btn btn-dark btn-sm"
                  >
                    Copy Description
                  </button>
                </div>
              </div>

              <div class="prompt-buttons">
                <button id="copyResumeMakePromptBtn" type="button" class="btn btn-outline-dark btn-sm">
                  Copy Resume Make Prompt
                </button>
                <button id="copyCreateCvPromptBtn" type="button" class="btn btn-outline-dark btn-sm">
                  Copy Create CV Prompt
                </button>
                <button id="copyAnalyzeResumePromptBtn" type="button" class="btn btn-outline-dark btn-sm">
                  Copy Analyze Resume Prompt
                </button>
                <button id="copyCoverLetterPromptBtn" type="button" class="btn btn-outline-dark btn-sm">
                  Copy Cover Letter Prompt
                </button>
              </div>

              <div id="modalContentTitle" class="modal-section-title mt-3">Full Job Description</div>
              <div id="modalContentBox" class="modal-description">N/A</div>

              <div class="mt-4">
                <div class="modal-section-title">Missing Keywords</div>
                <div id="modalMissingKeywords" class="chip-wrap"></div>
              </div>

              <div class="mt-4">
                <div class="modal-section-title">Strong Matches</div>
                <div id="modalStrongMatches"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const userProfileText = <%- JSON.stringify(userProfileText || "") %>;
    const googleDocUrl = <%- JSON.stringify(googleDocUrl || "") %>;

    let currentModalJob = {
      url: "",
      description: "",
      summary: "",
      missingKeywords: [],
      strongMatches: [],
      activeView: "description",
      title: "",
      source: "",
      location: "",
      status: ""
    };

    function showCopied(button, originalText) {
      const oldText = originalText || button.innerText;
      button.innerText = "Copied!";
      button.classList.add("copied");

      setTimeout(() => {
        button.innerText = oldText;
        button.classList.remove("copied");
      }, 1500);
    }

    async function copyPlainText(text, button, fallbackLabel) {
      try {
        await navigator.clipboard.writeText(text || "");
        showCopied(button, fallbackLabel || button.innerText);
      } catch (error) {
        alert("Failed to copy");
        console.error("Copy failed:", error);
      }
    }

    function updateModalContentView(view) {
      const contentBox = document.getElementById("modalContentBox");
      const contentTitle = document.getElementById("modalContentTitle");
      const copyBtn = document.getElementById("modalCopyContentBtn");
      const descBtn = document.getElementById("showDescriptionBtn");
      const summaryBtn = document.getElementById("showSummaryBtn");

      currentModalJob.activeView = view;

      if (view === "summary") {
        contentTitle.innerText = "AI Summary";
        contentBox.innerText = currentModalJob.summary || "No summary available";
        copyBtn.innerText = "Copy Summary";
        descBtn.classList.remove("active-view");
        summaryBtn.classList.add("active-view");
      } else {
        contentTitle.innerText = "Full Job Description";
        contentBox.innerText = currentModalJob.description || "N/A";
        copyBtn.innerText = "Copy Description";
        summaryBtn.classList.remove("active-view");
        descBtn.classList.add("active-view");
      }

      copyBtn.classList.remove("copied");
    }

    function renderModalAnalysis() {
      const missingKeywordsBox = document.getElementById("modalMissingKeywords");
      const strongMatchesBox = document.getElementById("modalStrongMatches");

      missingKeywordsBox.innerHTML = "";
      strongMatchesBox.innerHTML = "";

      if (currentModalJob.missingKeywords?.length) {
        currentModalJob.missingKeywords.forEach((keyword) => {
          const span = document.createElement("span");
          span.className = "chip";
          span.innerText = keyword;
          missingKeywordsBox.appendChild(span);
        });
      } else {
        missingKeywordsBox.innerHTML = '<span class="muted">No data</span>';
      }

      if (currentModalJob.strongMatches?.length) {
        const ul = document.createElement("ul");
        ul.className = "list";

        currentModalJob.strongMatches.forEach((point) => {
          const li = document.createElement("li");
          li.innerText = point;
          ul.appendChild(li);
        });

        strongMatchesBox.appendChild(ul);
      } else {
        strongMatchesBox.innerHTML = '<div class="muted">No data</div>';
      }
    }

    function getProfileBlock() {
      const sourceLine = googleDocUrl
        ? `PROFILE SOURCE:\n${googleDocUrl}`
        : "PROFILE SOURCE:\nLocal fallback profile. Set GOOGLE_DOC_URL to use Google Docs.";

      return `${sourceLine}\n\nMY RESUME / PROFILE DATA:\n${userProfileText || "[No profile data loaded]"}`;
    }

    function getResumeMakePrompt() {
      return `You are an expert technical recruiter and resume writer who specializes in ATS optimization 
(Greenhouse, Lever, Workday) and human recruiter readability.
TASK:
Generate a job-specific resume using LaTeX.

STRICT CONSTRAINTS (DO NOT VIOLATE):
- DO NOT change the LaTeX structure, layout, spacing, column setup, or section order.
- DO NOT introduce tables, text boxes, TikZ, icons-as-text, or images containing text.
- DO NOT invent experience, tools, metrics, or companies.
- DO NOT use generic or motivational language.
- DO NOT sound like AI. Write like a strong senior engineer describing real work.
- Keep formatting clean, ATS-readable, and human-friendly.

INPUTS YOU WILL RECEIVE:
1. My current LaTeX resume (this defines the format — preserve it exactly)
2. A job description (JD)
3. what I did in erience solution in details
4. list of project which I have built 

OUTPUT REQUIREMENTS:
- Modify ONLY the text content inside existing LaTeX commands.
- Preserve all headings, spacing, bullet structure, and alignment.
- Keep the same number of sections unless a section already exists.
- Output valid LaTeX only. No explanations.
- Keep the writing specific, human, and recruiter-readable.
- Output valid LaTeX only. No explanations.

${getProfileBlock()}

JOB DESCRIPTION:
${currentModalJob.description || "Paste JD here"}`;
    }

    function getCreateCvPrompt() {
      return `Create a professional CV for this job.

Rules:
- Make it tailored to the job
- Use strong ATS-friendly wording
- Keep it human and believable
- Focus on real engineering impact
- Do not add fake experience
- Keep skills and achievements relevant to the JD
- Prefer measurable outcomes
- Keep summary concise
- Select only the most relevant projects

I will paste my resume myself.

${getProfileBlock()}

JOB DESCRIPTION:
${currentModalJob.description || "Paste JD here"}`;
    }

    function getAnalyzeResumePrompt() {
      return `Act as a senior HR manager and ATS reviewer with 15+ years of experience in technical hiring.

Evaluate my resume/profile data from the Google Doc against the job description.

Return:
1. ATS compatibility score out of 100
2. Skills match table
3. Missing keywords
4. Experience gap analysis
5. Strong match areas
6. Weak areas
7. Exact improvements
8. ATS optimized summary
9. Final hiring probability
10. Improved resume sections

Use clear HR-level reasoning and actionable suggestions.

${getProfileBlock()}

JOB DESCRIPTION:
${currentModalJob.description || "[Paste job description here]"}`;
    }

    function getCoverLetterPrompt() {
      return `Write a short cover letter for this job application.

Make it sound natural, professional, and human.
Use simple English and connect the job description with my real experience/projects from the Google Doc profile.
Do not invent experience.
Keep it concise.

${getProfileBlock()}

JOB DESCRIPTION:
${currentModalJob.description || "Paste JD here"}`;
    }

    const jobModal = document.getElementById("jobModal");

    if (jobModal) {
      jobModal.addEventListener("show.bs.modal", function (event) {
        const button = event.relatedTarget;
        if (!button) return;

        const id = button.getAttribute("data-mainID") || "No ID";
        const title = button.getAttribute("data-title") || "Job Details";
        const source = button.getAttribute("data-source") || "Unknown Source";
        const Company_name = button.getAttribute("data-company_name") || "Unknown Company";
        const status = button.getAttribute("data-status") || "pending";
        const location = button.getAttribute("data-location") || "N/A";
        const capturedAt = button.getAttribute("data-capturedat") || "N/A";
        const createdAt = button.getAttribute("data-createdat") || "N/A";
        const url = button.getAttribute("data-url") || "";
        const description = button.getAttribute("data-description") || "N/A";
        const summary = button.getAttribute("data-summary") || "No summary available";

        let missingKeywords = [];
        let strongMatches = [];

        try {
          missingKeywords = JSON.parse(button.getAttribute("data-missingkeywords") || "[]");
        } catch (e) {
          missingKeywords = [];
        }

        try {
          strongMatches = JSON.parse(button.getAttribute("data-strongmatches") || "[]");
        } catch (e) {
          strongMatches = [];
        }

        currentModalJob = {
          title,
          source,
          status,
          location,
          url,
          description,
          summary,
          missingKeywords,
          strongMatches,
          Company_name,
          activeView: "description",
          id
        };
        // alert (id)
        document.getElementById("generateLink").href = `http://localhost:3000/generate/resume/${id}`;
        // document.getElementById("jobModalID").innerText = title;
        document.getElementById("jobModalLabel").innerText = title;
        document.getElementById("modalJobMeta").innerText = `${source} • ${status}`;
        document.getElementById("modalSource").innerText = source;
        document.getElementById("modalCompany_name").innerText = Company_name;
        document.getElementById("modalStatus").innerText = status;
        document.getElementById("modalLocation").innerText = location;
        document.getElementById("modalCapturedAt").innerText = capturedAt;
        document.getElementById("modalCreatedAt").innerText = createdAt;

        const modalUrlText = document.getElementById("modalUrlText");
        const modalOpenUrl = document.getElementById("modalOpenUrl");

        if (url) {
          modalUrlText.innerText = url;
          modalOpenUrl.href = url;
          modalOpenUrl.classList.remove("disabled");
          modalOpenUrl.setAttribute("aria-disabled", "false");
        } else {
          modalUrlText.innerText = "N/A";
          modalOpenUrl.href = "#";
          modalOpenUrl.classList.add("disabled");
          modalOpenUrl.setAttribute("aria-disabled", "true");
        }

        const copyUrlBtn = document.getElementById("modalCopyUrlBtn");
        copyUrlBtn.innerText = "Copy URL";
        copyUrlBtn.classList.remove("copied");

        updateModalContentView("description");
        renderModalAnalysis();
      });
    }

    document.getElementById("modalCopyUrlBtn").addEventListener("click", function () {
      copyPlainText(currentModalJob.url || "", this, "Copy URL");
    });

    document.getElementById("modalCopyContentBtn").addEventListener("click", function () {
      const textToCopy = currentModalJob.activeView === "summary"
        ? (currentModalJob.summary || "No summary available")
        : (currentModalJob.description || "N/A");

      const label = currentModalJob.activeView === "summary"
        ? "Copy Summary"
        : "Copy Description";

      copyPlainText(textToCopy, this, label);
    });

    document.getElementById("copyResumeMakePromptBtn").addEventListener("click", function () {
      copyPlainText(getResumeMakePrompt(), this, "Copy Resume Make Prompt");
    });

    document.getElementById("copyCreateCvPromptBtn").addEventListener("click", function () {
      copyPlainText(getCreateCvPrompt(), this, "Copy Create CV Prompt");
    });

    document.getElementById("copyAnalyzeResumePromptBtn").addEventListener("click", function () {
      copyPlainText(getAnalyzeResumePrompt(), this, "Copy Analyze Resume Prompt");
    });

    document.getElementById("copyCoverLetterPromptBtn").addEventListener("click", function () {
      copyPlainText(getCoverLetterPrompt(), this, "Copy Cover Letter Prompt");
    });

    document.getElementById("showDescriptionBtn").addEventListener("click", function () {
      updateModalContentView("description");
    });

    document.getElementById("showSummaryBtn").addEventListener("click", function () {
      updateModalContentView("summary");
    });
    const statusFilter = document.getElementById("statusFilter");
    const applicationStatusFilter = document.getElementById("applicationStatusFilter");
    const sourceFilter = document.getElementById("sourceFilter");
    const scoreFilter = document.getElementById("scoreFilter");
    const searchFilter = document.getElementById("searchFilter");

    function applyFilters() {
      const rows = document.querySelectorAll("#jobsTableBody tr");
      const status = (statusFilter.value || "").toLowerCase();
      const applicationStatus = (applicationStatusFilter.value || "").toLowerCase();
      const source = (sourceFilter.value || "").toLowerCase();
      const minScore = parseInt(scoreFilter.value || "0", 10) || 0;
      const search = (searchFilter.value || "").toLowerCase().trim();

      let visibleCount = 0;

      rows.forEach((row) => {
        const rowStatus = (row.dataset.status || "").toLowerCase();
        const rowApplicationStatus = (row.dataset.applicationStatus || "").toLowerCase();
        const rowSource = (row.dataset.source || "").toLowerCase();
        const rowScore = parseInt(row.dataset.score || "0", 10) || 0;
        const rowTitle = (row.dataset.title || "").toLowerCase();

        let visible = true;

        if (status && rowStatus !== status) visible = false;
        if (applicationStatus && rowApplicationStatus !== applicationStatus) visible = false;
        if (source && rowSource !== source) visible = false;
        if (rowScore < minScore) visible = false;
        if (search && !rowTitle.includes(search)) visible = false;

        row.classList.toggle("hidden-row", !visible);

        if (visible) visibleCount++;
      });

      const visibleJobsCount = document.getElementById("visibleJobsCount");
      if (visibleJobsCount) {
        visibleJobsCount.innerText = visibleCount;
      }

      const noMatchingJobsMessage = document.getElementById("noMatchingJobsMessage");
      if (noMatchingJobsMessage) {
        noMatchingJobsMessage.style.display = visibleCount === 0 ? "block" : "none";
      }
    }

     function clearFilters() {
      statusFilter.value = "";
      applicationStatusFilter.value = "";
      sourceFilter.value = "";
      scoreFilter.value = "";
      searchFilter.value = "";
      applyFilters();
    }
    statusFilter.addEventListener("change", applyFilters);
    applicationStatusFilter.addEventListener("change", applyFilters);
    sourceFilter.addEventListener("change", applyFilters);
    scoreFilter.addEventListener("input", applyFilters);
    searchFilter.addEventListener("input", applyFilters);

        async function updateApplicationStatus(jobId, applicationStatus) {
      const response = await fetch(`/api/jobs/${jobId}/application-status`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ applicationStatus })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Failed to update application status");
      }

      return data;
    }

    function formatApplicationStatus(status) {
      if (!status) return "not applied";
      return status.replace(/_/g, " ");
    }

    function getApplicationStatusBadgeClass(status) {
      return `status-badge app-status-badge app-status-${status || "not_applied"}`;
    }

    document.addEventListener("click", async function (e) {
      const button = e.target.closest(".restart-analysis-btn");
      if (!button || button.disabled) return;
      const originalText = button.innerText;
      button.disabled = true;
      button.innerText = "Queueing...";
      try {
        const response = await fetch(`/api/jobs/${button.dataset.jobId}/restart-analysis`, { method: "POST" });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || "Failed to restart analysis");
        window.location.reload();
      } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.innerText = originalText;
      }
    });

    document.addEventListener("click", async function (e) {
      if (!e.target.classList.contains("application-status-btn")) return;

      const button = e.target;
      const jobId = button.getAttribute("data-job-id");
      const newStatus = button.getAttribute("data-status");
      const row = button.closest("tr");

      if (!row || !jobId || !newStatus) return;

      const buttons = row.querySelectorAll(".application-status-btn");
      const badge = row.querySelector(".app-status-badge");

      const originalText = button.innerText;

      try {
        buttons.forEach(btn => btn.disabled = true);
        button.innerText = "Updating...";

        const result = await updateApplicationStatus(jobId, newStatus);
        const updatedStatus = result?.job?.applicationStatus || newStatus;

        row.dataset.applicationStatus = updatedStatus;

        if (badge) {
          badge.className = getApplicationStatusBadgeClass(updatedStatus);
          badge.innerText = formatApplicationStatus(updatedStatus);
        }

        applyFilters();
      } catch (error) {
        alert(error.message || "Failed to update application status");
      } finally {
        buttons.forEach(btn => btn.disabled = false);
        button.innerText = originalText;
      }
    });
  </script>
</body>
</html>
